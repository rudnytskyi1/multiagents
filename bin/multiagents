#!/bin/sh
# multiagents CLI. Claude Code adds a plugin's bin/ to the Bash tool's PATH while it is enabled.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd -P)
# Find a Python 3.9+: "python3" (macOS/Linux), "python" (Windows), or the "py" launcher.
# The version probe also weeds out the Windows Store stub that only opens the Store.
PY=""
for c in python3 python; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    PY=$c
    break
  fi
done
if [ -z "$PY" ] && command -v py >/dev/null 2>&1 && py -3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
  exec py -3 "$here/../worker/multiagents.py" "$@"
fi
if [ -z "$PY" ]; then
  echo "multiagents: Python 3.9+ not found (tried python3, python, py -3)" >&2
  exit 2
fi
exec "$PY" "$here/../worker/multiagents.py" "$@"
