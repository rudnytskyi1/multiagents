#!/bin/sh
# multiagents CLI. Claude Code adds a plugin's bin/ to the Bash tool's PATH while it is enabled.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd -P)
exec python3 "$here/../worker/multiagents.py" "$@"
